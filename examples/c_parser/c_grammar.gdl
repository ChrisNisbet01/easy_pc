// GDL definition for a basic C-like parser
// Supports global variables, function definitions, and basic statements/expressions.

// --- Lexical Elements ---

// Identifiers: [a-zA-Z_][a-zA-Z0-9_]*
IdChar = alpha | digit | '_';
IdPrefix = alpha | '_';
IdRest = IdChar*;
FullId = IdPrefix IdRest;
Identifier = lexeme(FullId);

// Numbers: [0-9]+
NumberLiteral = lexeme(digit+);

// Keywords - Storage Classes
KwStatic = lexeme("static");
KwExtern = lexeme("extern");
KwAuto = lexeme("auto");
KwRegister = lexeme("register");

// Keywords - Type Qualifiers
KwConst = lexeme("const");
KwVolatile = lexeme("volatile");

// Keywords - Types
KwVoid = lexeme("void");
KwChar = lexeme("char");
KwShort = lexeme("short");
KwInt = lexeme("int");
KwLong = lexeme("long");
KwFloat = lexeme("float");
KwDouble = lexeme("double");
KwSigned = lexeme("signed");
KwUnsigned = lexeme("unsigned");

KwReturn = lexeme("return");

// Operators and Punctuation
LParen = lexeme('(');
RParen = lexeme(')');
LBrace = lexeme('{');
RBrace = lexeme('}');
Semicolon = lexeme(';');
Comma = lexeme(',');
Assign = lexeme('=');
PlusAssign = lexeme("+=");
Star = lexeme('*');
Minus = lexeme('-');
Plus = lexeme('+');
Slash = lexeme('/');
Percent = lexeme('%');
Dot = lexeme('.');
Arrow = lexeme("->");

// --- Grammar Rules ---

TranslationUnit = ExternalDeclaration+;

ExternalDeclaration = FunctionDefinition | FunctionDeclaration | Declaration;

// Function Definition: [specifiers] declarator ( params ) { body }
FunctionDefinition = DeclarationSpecifiers Declarator ParameterList CompoundStatement;

// Function Declaration: [specifiers] declarator ( params ) ;
FunctionDeclaration = DeclarationSpecifiers Declarator ParameterList Semicolon;

// Declaration: [specifiers] init_declarator_list ;
Declaration = DeclarationSpecifiers InitDeclaratorList? Semicolon;

DeclarationSpecifiers = DeclarationSpecifier+;

DeclarationSpecifier = StorageClassSpecifier
                     | TypeQualifier
                     | TypeSpecifier;

StorageClassSpecifier = KwStatic | KwExtern | KwAuto | KwRegister;

TypeQualifier = KwConst | KwVolatile;

TypeSpecifier = KwVoid | KwChar | KwShort | KwInt | KwLong 
              | KwFloat | KwDouble | KwSigned | KwUnsigned;

InitDeclarator = Declarator (Assign AssignmentExpression)?;

InitDeclaratorList = delimited(InitDeclarator, Comma);

// Declarator: supports pointers: int *p, **pp, * const p;
Pointer = Star TypeQualifier*;
Declarator = Pointer* Identifier;

ParameterList = LParen ParameterTypeList? RParen;

ParameterDeclaration = DeclarationSpecifiers Declarator?;

ParameterTypeList = delimited(ParameterDeclaration, Comma);

CompoundStatement = LBrace Statement* RBrace;

Statement = CompoundStatement
          | Declaration
          | JumpStatement
          | ExpressionStatement
          ;

ExpressionStatement = Expression? Semicolon;

JumpStatement = KwReturn Expression? Semicolon;

// --- Expression Hierarchy ---

AssignmentExpression = UnaryExpression AssignmentOp AssignmentExpression
                     | AdditiveExpression
                     ;

Expression = AssignmentExpression;

AssignmentOp = Assign | PlusAssign;

ArgumentList = delimited(AssignmentExpression, Comma);

PostfixPart = LParen ArgumentList? RParen
            | Dot Identifier
            | Arrow Identifier
            ;

PrimaryExpression = NumberLiteral
                  | Identifier
                  | LParen Expression RParen
                  ;

PostfixExpression = PrimaryExpression PostfixPart*;

UnaryExpression = PostfixExpression;

MulOp = Star | Slash | Percent;
MultiplicativeExpression = chainl1(UnaryExpression, MulOp);

AddOp = Plus | Minus;
AdditiveExpression = chainl1(MultiplicativeExpression, AddOp);

// The top-level rule MUST be the last one in the file.
Program = TranslationUnit eoi;
